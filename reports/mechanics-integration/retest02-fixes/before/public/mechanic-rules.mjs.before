// Definition links only: these do not detect card behavior or authorize searches.
// Reviewed against the retained September 25, 2026 rules headings and clauses.
export const RULES_REVISION = Object.freeze({
  date: '2026-09-25',
  sourceSha256: '8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca',
});
export const MECHANIC_RULE_LINKS = Object.freeze({
  adapt: '701.46', changeling: '702.73', convoke: '702.51', crew: '702.122',
  deathtouch: '702.2', 'double strike': '702.4', equip: '702.6', evolve: '702.100',
  fight: '701.14', 'first strike': '702.7', flash: '702.8', flying: '702.9',
  haste: '702.10', indestructible: '702.12', lifelink: '702.15', mayhem: '702.187', menace: '702.111',
  mill: '701.17', proliferate: '701.34', reach: '702.17', riot: '702.136',
  station: '702.184', surveil: '701.25', trample: '702.19', transform: '701.27',
  vigilance: '702.20', ward: '702.21', 'web-slinging': '702.188',
});
export function mechanicRule(data, label) {
  if (typeof label !== 'string' || data?.date !== RULES_REVISION.date || data?.sourceSha256 !== RULES_REVISION.sourceSha256) return null;
  const key = label.toLowerCase(), number = MECHANIC_RULE_LINKS[key];
  const section = data.sections?.[number];
  return section?.title?.toLowerCase() === key && section.paragraphs?.length ? number : null;
}

// Explicit explanatory references, separate from keyword definitions and detection.
// Exact retained clauses guard these links as well as the source revision.
const EXPLANATORY_RULES = Object.freeze({
  '111.10': 'Some effects instruct a player to create a predefined token. These effects use the definition below to determine the characteristics the token is created with. The effect that creates a predefined token may also modify or add to the predefined characteristics.',
  '111.10b': 'A Food token is a colorless Food artifact token with “{2}, {T}, Sacrifice this token: You gain 3 life.”',
  '205.3g': 'Artifacts have their own unique set of subtypes; these subtypes are called artifact types. The artifact types are Attraction (see rule 717), Blood, Bobblehead, Book, Clue, Contraption, Equipment (see rule 301.5), Food, Fortification (see rule 301.6), Gold, Heartwood, Incubator, Infinity, Junk, Lander, Map, Mutagen, Powerstone, Spacecraft, Stone, Treasure, Vehicle (see rule 301.7), and Vibranium.',
  '207.2d': 'Similar to ability words, flavor words appear in italics at the beginning of some abilities. Flavor words provide a flavorful description of abilities, but they have no special rules meaning and are not listed in the Comprehensive Rules. While an ability word ties together several abilities with similar functionality, each flavor word is tailored to the specific ability it appears with.',
});
export function mechanicExplanation(data, label) {
  if (typeof label !== 'string' || data?.date !== RULES_REVISION.date || data?.sourceSha256 !== RULES_REVISION.sourceSha256) return null;
  const key=label.toLowerCase();
  const explanation=key==='food'?{
    title:'Food tokens and Food artifacts',
    summary:'Food is an artifact subtype. The standard Food token has the ability below; other Food artifacts do not automatically have that ability. A creating effect may modify the token’s predefined characteristics.',
    rules:['111.10b','111.10','205.3g'],
  }:key==='eternity gate'?{
    title:'Eternity Gate: a flavor word',
    summary:'Eternity Gate labels a card-specific ability; it has no independent rules meaning. Read the contributing card’s full Oracle text below. This reference explains flavor words, not a separate Eternity Gate keyword rule.',
    rules:['207.2d'], showCardText:true,
  }:null;
  return explanation?.rules.every(number=>data.rules?.[number]?.text===EXPLANATORY_RULES[number])?explanation:null;
}
